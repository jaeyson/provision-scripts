IMGPROXY_USE_S3=true
AWS_REGION="{{ imgproxy_s3_region }}"
IMGPROXY_S3_ENDPOINT="{{ imgproxy_s3_endpoint }}"
AWS_ACCESS_KEY_ID="{{ aws_access_key_id }}"
AWS_SECRET_ACCESS_KEY="{{ aws_secret_access_key }}"
IMGPROXY_FALLBACK_IMAGE_URL="{{ imgproxy_fallback_image_url }}"
IMGPROXY_FALLBACK_IMAGE_HTTP_CODE="{{ imgproxy_fallback_image_http_code }}"
IMGPROXY_JPEG_PROGRESSIVE=true
IMGPROXY_ENABLE_CLIENT_HINTS=true
IMGPROXY_AUTO_WEBP=true
IMGPROXY_AUTO_AVIF=true
IMGPROXY_AUTO_JXL=true
IMGPROXY_KEEP_ALIVE_TIMEOUT=60
IMGPROXY_DOWNLOAD_TIMEOUT=30
